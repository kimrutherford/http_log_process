#vi gnuplot_commands && gnuplot gnuplot_commands && open requests_per_week.svg

set datafile separator ','
set timefmt '%Y-%m-%d'
set xdata time
set autoscale xfix
set style line 1 lw 4 lc rgb "#c02300"
set style line 2 lw 4 lc rgb "#333"
set xlabel "Date" font "Arial,28" offset 0,-2.5
set lmargin 20
set xtics font "Arial,22" rotate by 50 offset -1.2,-0.5 right
set ytics font "Arial,22"
set decimalsign locale
set decimalsign ","
set format y "%'.0f"
set format x "%B"
set boxwidth 0.8 relative
set style fill solid noborder
set key off
set size ratio 0.6
set term svg size 1280 900
set offsets 0, 1, 1, 100000
